#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e5 + 5;
vector<int>g[maxn];
long long h[maxn], up[maxn][17];

void dfs (int u){
    for (int v:g[u]){
        if (v == up[u][0]) continue;
        h[v] = h[u] + 1;

        up[v][0] = u;
        for (int j=1; j<17; ++j){
            up[v][j] = up[up[v][j-1]][j-1];
        }
        dfs(v);
    }
}

int lca(int u, int v){
    if (h[u] != h[v]){
        if (h[u] < h[v]) swap (u,v);
        int k = h[u] - h[v];

        for (int j=0; (1<<j)<=k; ++j){
            if (k >> j & 1){
                u = up[u][j];
            }
        }
    }
    if (u == v) return v;

    int k = __lg(h[u]);
    for (int j=k; j>=0; --j){
        if (up[u][j] != up[v][j]){
            u = up[u][j];
            v = up[v][j];
        }
    }
    return up[u][0];
}

int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0); cout.tie(0);

    freopen("LCA2.INP", "r", stdin);
    freopen("LCA2.OUT", "w", stdout);

    int n;
    cin >> n;

    for (int i=1; i<n; ++i){
        int x,y;
        cin  >> x >> y;
        g[x].emplace_back(y);
        g[y].emplace_back(x);
    }

    h[1] = 0;
    dfs(1);

    int q;
    cin >> q;
    while (q--){
        int u,v,r;
        cin >> u >> v >> r;
        int t1 = lca(u,v);
        int t2 = lca(u,r);
        int t3 = lca(v,r);
        cout << (t1 ^ t2 ^ t3) << '\n';
    }
    return 0;
}
