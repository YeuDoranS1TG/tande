#include <bits/stdc++.h>
using namespace std;
#define maxN 100000+5
int m,k;
int a[maxN];
int main() {
	cin>>m>>k;
    for (int i=0;i<m;++i){
        cin>>a[i];
    }
    int b[m+5];
    fill(b,b+m+5,0);
    int sum=0;
    priority_queue<pair<int,int>,vector<pair<int,int>>, greater<pair<int,int>>>q;
    for (int i=0;i<m;++i){
        q.push({a[i],i});
        while (!q.empty() && q.top().second<i-k+1){
            q.pop();
        }
        sum+=q.top().first*2;
        b[q.top().second]+=2;
    }
    cout<<sum<<'\n';
    for (int i=0;i<m;++i){
        cout<<b[i]<<" ";
    }
}
