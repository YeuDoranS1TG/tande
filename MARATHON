#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e5 + 5;
vector<int>g[maxn];
int h[maxn], up[maxn][17];

void dfs (int u){
    for (int v:g[u]){
        if (v == up[u][0]) continue;
        h[v] = h[u] + 1;

        up[v][0] = u;
        for (int j=1; j<17; ++j){
            up[v][j] = up[up[v][j-1]][j-1];
        }
        dfs(v);
    }
}

int lca(int u, int v){
    if (h[u] != h[v]){
        if (h[u] < h[v]) swap (u,v);
        int k = h[u] - h[v];

        for (int j=0; (1<<j)<=k; ++j){
            if (k >> j & 1){
                u = up[u][j];
            }
        }
    }
    if (u == v) return v;

    int k = __lg(h[u]);
    for (int j=k; j>=0; --j){
        if (up[u][j] != up[v][j]){
            u = up[u][j];
            v = up[v][j];
        }
    }
    return up[u][0];
}

int dist(int u, int v){
    return h[u] + h[v] - (2 * h[lca(u,v)]);
}

int jump(int u, int k){
    for(int j=0; j<17; j++)
        if(k >> j & 1)
            u = up[u][j];
    return u;
}

int move(int u, int v, int d){
    int l = lca(u,v);
    int du = h[u] - h[l];
    int dv = h[v] - h[l];

    if (d <= du){
        return jump(u,d);
    }

    int temp = d - du;
    return jump(v,dv - temp);

}

int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0); cout.tie(0);

    int n,q;
    cin >> n >> q;

    for (int i=1; i<n; ++i){
        int x,y;
        cin  >> x >> y;
        g[x].emplace_back(y);
        g[y].emplace_back(x);
    }

    h[1] = 0;
    dfs(1);

    while (q--){
        int u,v,w;
        cin >> u >> v >> w;

        int d = dist(u,w);
        int d1 = dist(u,v);

        if (d > d1){
            cout << 0 << '\n';
            continue;
        }

        int p = move(u,v,d);

        if (p == w){
            cout << 1 << '\n';
            continue;
        }
        else cout << 0 << '\n';

    }
    return 0;
}
