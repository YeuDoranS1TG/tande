#include <bits/stdc++.h>
using namespace std;
#define ll long long
int main() {
	ios_base::sync_with_stdio(0);
    cin.tie(0);
    freopen("SBORDER.INP", "r", stdin);
    freopen("SBORDER.OUT", "w", stdout);

    string s;
    cin >> s;
    int n = (int)s.size();

    vector<int>z(n,0);
    int l = 0, r = 0;
    for (int i=1; i<n; ++i){
        if (i<=r){
            z[i] = min(r-i+1,z[i-l]);
        }
        while (i+z[i] < n && s[z[i]] == s[i + z[i]])
            ++z[i];
        if (i+z[i]-1 > r){
            l=i;
            r=i+z[i]-1;
        }
    }

    vector<int>ans;
    for (int i=1; i<n; ++i){
        if (z[n-i] == i){
            ans.push_back(i);
        }
    }
    //if (ans.empty()) cout << 0;
    for (auto x:ans){
        cout << x << " ";
    }
}
