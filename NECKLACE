#include <bits/stdc++.h>
using namespace std;
#define maxN 50+1
vector<int>g[maxN];
int dem[maxN];
//bool vis[maxN][maxN]={0};
bool visited[maxN]={0};
int cnt[maxN][maxN];
vector<pair<int,int>>ans;
void dfs(int u){
    for (auto &e:g[u]){
        if (cnt[u][e]>0){
            --cnt[u][e];
            --cnt[e][u];

            dfs(e);
            ans.push_back({u, e});
        }
    }
}
void bfs(int u){
    queue<int>q;
    visited[u]=true;
    q.push(u);
    while(!q.empty()){
        int v=q.front();
        q.pop();
        for (auto &e:g[v]){
            if (!visited[e]){
                q.push(e);
                visited[e]=true;
            }
        }
    }
}
int main() {
	ios_base::sync_with_stdio(0);
	cin.tie(0); cout.tie(0);
    freopen("NECKLACE.INP","r",stdin);
    freopen("NECKLACE.OUT","w",stdout);
	int t;
    cin>>t;
    while (t--){
        int n;
        cin>>n;
        ans.clear();
        for (int i=1;i<=50;++i){
            dem[i]=0;
            g[i].clear();
            for (int j=1;j<=50;++j){
                cnt[i][j]=0;
            }
            visited[i]=false;
        }
        for (int i=0;i<n;++i){
            int x,y;
            cin>>x>>y;
            ++cnt[x][y], ++cnt[y][x];
            ++dem[x], ++dem[y];
            g[x].push_back(y);
            g[y].push_back(x);
        }
        bool ok = true;
        for(int i=1;i<=50;i++){
            if(dem[i] % 2 != 0){
                ok = false;
                break;
            }
        }
        if (!ok){ cout<<"NO"<<'\n'; continue;}
        int start=-1;
        for (int i=1;i<=50;++i){
            if (dem[i]>0){
                start=i;
                break;
            }
        }
        if (start==-1){ cout<<"NO"<<'\n'; continue;}
        bfs(start);
        for(int i=1;i<=50;i++){
            if(dem[i] > 0 && !visited[i]){
                ok = false;
                break;
            }
        }
        if (!ok){ cout<<"NO"<<'\n'; continue;}
        cout<<"YES"<<'\n';
        dfs(start);
        reverse(ans.begin(), ans.end());
        for (auto &h:ans){
            cout<<h.first<<" "<<h.second<<'\n';
        }
    }
    return 0;
}
