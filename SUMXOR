#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e6 + 5;
int n;
int a[maxn];
int main() {
	ios::sync_with_stdio(0);
    cin.tie(nullptr);
    freopen("SUMXOR.INP","r",stdin);
    freopen("SUMXOR.OUT","w",stdout);

    cin>>n;
    for (int i=0; i<n; ++i){
        cin>>a[i];
    }

    long long ans=0;
    for (int i=0; i<31; ++i){
        int cnt1=0, cnt0=0;
        int bit=(1<<i);

        for (int i=0; i<n; ++i){
            if (a[i] & bit) ++cnt1;
            else ++cnt0;
        }

        ans += cnt1 * cnt0 * bit;
    }

    cout<<ans;
    return 0;
}
