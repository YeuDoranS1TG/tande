#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e5+5;

struct nodes{
    int lazy;
    int val;
};
nodes nod[4*maxn];

void down(int id){
    int len=nod[id].lazy;
    nod[2*id].lazy+=len;
    nod[2*id].val+=len;

    nod[2*id+1].lazy+=len;
    nod[2*id+1].val+=len;

    nod[id].lazy=0;
}

void update(int id, int l, int r, int u, int v, int val){
    if (l>v || r<u) return;
    if (l>=u && r<=v){
        nod[id].val+=val;
        nod[id].lazy+=val;
        return;
    }

    int mid=(l+r)>>1;
    down(id);

    update(2*id,l,mid,u,v,val);
    update(2*id+1,mid+1,r,u,v,val);

    nod[id].val=max(nod[2*id].val,nod[2*id+1].val);
}

long long get(int id, int l, int r, int u, int v){
    if (l>v || r<u) return 0;
    if (l>=u && r<=v) return nod[id].val;

    int mid=(l+r)>>1;
    down(id);

    long long val1=get(2*id,l,mid,u,v);
    long long val2=get(2*id+1,mid+1,r,u,v);
    return max(val1,val2);
}
int main() {
	ios_base::sync_with_stdio(0);
	cin.tie(0); cout.tie(0);
    //freopen(".INP","r",stdin);
    //freopen(".OUT","w",stdout);

    int n,k,m;
    cin>>n>>k>>m;

    for (int i=1;i<=n;++i){
        nod[i].lazy=0;
        nod[i].val=0;
    }

    while (m--){
        int u,v;
        cin>>u>>v;
        long long get1=get(1,0,n-1,u,v-1);
        if (get1>=k){
            cout<<0<<'\n';
        }
        else {
            cout<<1<<'\n';
            update(1,0,n-1,u,v-1,1);
        }
    }
    return 0;
}
