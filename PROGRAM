#include <bits/stdc++.h>
using namespace std;
#define maxN 100000+5
int in[maxN];
vector<int>g[maxN];
vector<int>ar;
int t[maxN];
long long dp[maxN];
int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0); cout.tie(0);
    freopen("PROGRAM.INP", "r", stdin);
    freopen("PROGRAM.OUT", "w", stdout);
    int n,m;
    cin>>n>>m;
    for (int i=1;i<=n;++i){
        in[i]=0;
        dp[i]=0;
    }
    for (int i=1;i<=n;++i) cin>>t[i];
    for (int i=1;i<=m;++i){
        int x,y;
        cin>>x>>y;
        g[x].push_back(y);
        ++in[y];
    }
    queue<int>q;
    for (int i=1;i<=n;++i){
        if(in[i]==0){
            q.push(i);
            //ar.push_back(i);
        }
    }
    while (!q.empty()){
        int u=q.front();
        q.pop();
        for (int &e:g[u]){
            --in[e];
            if (in[e]==0) q.push(e);
        }
        ar.push_back(u);
    }
    //for (int h:ar) cout<<h<<" ";
    long long total=0;
    for (int i=0;i<n;++i){
        int xy=ar[i];
        dp[xy]=max(dp[xy],1LL);
        for (int v:g[xy]){
            dp[v]=max(dp[v],dp[xy]+t[xy]);
        }
        total=max(total, dp[xy]+t[xy]-1);
    }
    cout<<total<<'\n';
    for (int i=1;i<=n;++i){
        cout<<dp[i]<<'\n';
    }
    return 0;
}
