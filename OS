#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e5+5;
int cnt=0;
struct nodes{
    bool st;
};
nodes nod[4*maxn];

void build(int id, int l, int r){
    nod[id].st=false;
    if (l == r) return;

    int mid=(l+r)>>1;
    build(2*id, l, mid);
    build(2*id+1, mid+1, r);
}

void update(int id, int l, int r, long long u, long long v){
    if (l>v || r<u) return;
    if (nod[id].st) return;
    if (l>=u && r<=v){
        nod[id].st=true;
        return;
    }

    int mid=(l+r)>>1;
    update(2*id, l, mid, u, v);
    update(2*id+1, mid+1, r, u, v);
    nod[id].st = nod[id*2].st && nod[id*2+1].st;
}

bool empty(int id, int l, int r, long long u, long long v){
    if (l>v || r<u) return true;
    if (nod[id].st) return false;
    if (l==r) return true;
    
    int mid=(l+r)>>1;
    return empty(2*id, l, mid, u, v) && empty(2*id+1, mid+1, r, u, v);
}

int main() {
	ios_base::sync_with_stdio(0);
	cin.tie(0); cout.tie(0);
    //freopen(".INP","r",stdin);
    //freopen(".OUT","w",stdout);

    long long n;
    int q;
    cin>>n;
    cin>>q;

    vector<pair<long long, long long>>a;
    vector<long long>ar;
    for (int i=1;i<=q;++i){
        long long x,y;
        cin>>x>>y;
        a.push_back({x,y});
        ar.push_back(x);
        ar.push_back(y);
    }

    sort(ar.begin(), ar.end());
    ar.erase(unique(ar.begin(), ar.end()), ar.end()); 

    for (int i=0;i<q; ++i){
        a[i].first = lower_bound(ar.begin(), ar.end(), a[i].first) - ar.begin() +1; 
        a[i].second = lower_bound(ar.begin(), ar.end(), a[i].second) - ar.begin() +1;
    }

    int m=(int)ar.size();
    build(1,0,m-1);
    
    for (int i=q-1;i>=0;--i){
        long long x=a[i].first, y=a[i].second;

        if (empty(1,0,m-1,x,y)){
            ++cnt;
        }
    //     cout << "query [" << x << "," << y << "] empty = "
    //  << empty(1,0,m-1,x,y) << '\n';
        update(1,0,m-1,x,y);

    }
    
    cout<<cnt;
    return 0;
}
