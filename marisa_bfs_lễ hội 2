#include <bits/stdc++.h>
using namespace std;
#define maxN 1000+5
int n,m,k;
int p[maxN];
vector<int>g[maxN];
int dist[maxN][maxN];
vector<pair<int,int>>h;
void bfs(int t,int d[]){
    d[t]=0;
    queue<int>q;
    q.push(t);
    while (!q.empty()){
        int u=q.front();
        q.pop();
        for (auto v:g[u]){
            if (d[v]==-1){
                d[v]=d[u]+1;
                q.push(v);
            }
        }
    }
}
int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);cout.tie(0);
    //freopen("PRIM.INP","r",stdin);
    //freopen("PRIM.OUT","w",stdout);
    cin>>n>>m>>k;
    for (int i=1;i<=k;++i){
        cin>>p[i];
    }
    for (int i=0;i<m;++i){
        int u,v;
        cin>>u>>v;
        g[u].push_back(v);
        g[v].push_back(u);
        h.push_back({u,v});
    }
    memset(dist,-1,sizeof(dist));
    for (int i=1;i<=k;++i){
        bfs(p[i],dist[p[i]]);
    }
    long long best=LLONG_MAX;
    for (int i=0;i<m;++i){
        int u=h[i].first;
        int v=h[i].second;
        long long sum=0;
        for (int j=1;j<=k;++j){
            int du=dist[p[j]][u], dv=dist[p[j]][v];
            if (du==-1 && dv==-1) continue;
            else if (du==-1) sum+=dv;
            else if (dv==-1) sum+=du;
            else sum+=min(du,dv);
        }
        if (sum<best){
            best=sum;
        }
    }
    cout<<best;
    return 0;
}
