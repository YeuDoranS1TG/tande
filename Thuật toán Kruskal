#include <bits/stdc++.h>
using namespace std;
#define maxN 100000+5
struct edges{
    int u,v;
    int w;
};
int n,m;
vector<int>par;
edges g[maxN];
bool vis[maxN];
bool unions(int ru, int rv){
    if (ru==rv) return false;
    par[rv]=ru;
    return true;
}
int findroot(int x){
    if (par[x]==x) return x;
    return par[x]=findroot(par[x]);
}

int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0); cout.tie(0);
    freopen("KRUSKAL.INP","r",stdin);
    freopen("KRUSKAL.OUT","w",stdout);
    cin>>n>>m;
    for (int i=0;i<m;++i){
        int u,v,w;
        cin>>u>>v>>w;
        g[i].u=u, g[i].v=v, g[i].w=w;
    }
    par.resize(n+1);
    for (int i=1;i<=n;++i){
        par[i]=i;
    }
    sort(g,g+m,[](const edges &a, const edges &b){
         return a.w<b.w;
    });
    long long sum=0;
    for (int i=0;i<m;++i){
        int ru=findroot(g[i].u);
        int rv=findroot(g[i].v);
        if (unions(ru,rv)) sum+=g[i].w;
    }
    cout<<sum;
	return 0;
}
