#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e5 + 5;
vector<int>g[maxn];
int h[maxn], up[maxn][17];
int val[maxn], value[maxn];

void dfs1(int u){
    for (int v:g[u]){
        if (v == up[u][0]) continue;
        h[v] = h[u] + 1;

        up[v][0] = u;
        for (int j=1; j<17; ++j){
            up[v][j] = up[up[v][j-1]][j-1];
        }
        dfs1(v);
    }
}

int lca(int u, int v){
    if (h[u] != h[v]){
        if (h[u] < h[v]) swap (u,v);
        int k = h[u] - h[v];

        for (int j=0; (1<<j)<=k; ++j){
            if (k >> j & 1){
                u = up[u][j];
            }
        }
    }
    if (u == v) return v;

    int k = __lg(h[u]);
    for (int j=k; j>=0; --j){
        if (up[u][j] != up[v][j]){
            u = up[u][j];
            v = up[v][j];
        }
    }
    return up[u][0];
}

