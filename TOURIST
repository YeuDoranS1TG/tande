int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    //freopen("Tourist,inp", "r", stdin);
    //freopen("Tourist.out", "w", stdout);

    int n;
    cin >> n;

    for (int i=1; i<n; ++i){
        int x,y;
        cin >> x >> y;
        g[x].push_back(y);
        g[y].push_back(x);
    }

    h[1] = 0;
    up[1][0] = 0;
    dfs1(1);

    long long ans = 0;
    for (int u=1; u<=n; ++u){
        for (int v=2; v*u<=n; ++v){
            int z = u*v;

            int p = lca(u,z);
            ans += h[u] + h[z] - 2*h[p] + 1;
        }
    }

    cout << ans << '\n';
    return 0;
}
