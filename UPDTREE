int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    freopen("UPDTREE.INP", "r", stdin);
    freopen("UPDTREE.OUT", "w", stdout);

    int n;
    cin >> n;

    for (int i = 1; i <= n; ++i){
        cin >> value[i];
        val[i] = 0;
    }

    for (int i=1; i<n; ++i){
        int x,y;
        cin  >> x >> y;
        g[x].push_back(y);
        g[y].push_back(x);
    }

    h[1] = 0;
    up[1][0] = 0;
    dfs1(1);

    int q; cin >> q;
    while (q--){
        int u,v,w;
        cin >> u >> v >> w;

        int p = lca(u,v);

        val[u] += w;
        val[v] += w;
        val[p] -= w;

        if (p != 1){
            val[up[p][0]] -= w;
        }
    }

    dfs2(1);

    // for (int i=1; i<=n; ++i){
    //     cout << value[i]  << " " << val[i]<< '\n';
    // }
    // cout << '\n';
    for (int i=1; i<=n; ++i){
        cout << value[i] + val[i] << " ";
    }
    return 0;
}
