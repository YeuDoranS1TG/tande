#include <bits/stdc++.h>
using namespace std;
#define maxN 1000000+5
struct edge{
    int v,id;
};
vector<edge>g[maxN];
bool vis[maxN]={0};
vector<int>ans;
vector<int>path;
void dfs(int u){
    for (auto &e:g[u]){
        int v=e.v, id=e.id;
        //path.push_back(v);
        if (!vis[id]){
            vis[id]=true;
            //cout<<(id+1)/2<<" ";
            //path.push_back(v);
            dfs(v);
            ans.push_back(id);
        }
    }
